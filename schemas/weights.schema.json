{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Weights",
  "type": "object",
  "required": ["version", "score_groups"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string"
    },
    "score_groups": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    }
  }
}
